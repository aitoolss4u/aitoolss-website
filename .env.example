# Copy to .env.local for local development. Never commit .env.local.
# These are the Supabase project URL and publishable/anon key, intended for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side contact delivery through Resend (keep these values out of NEXT_PUBLIC_* variables).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Cloudflare R2 (server-only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aitoolss-gallery
R2_S3_ENDPOINT=
R2_PUBLIC_BASE_URL=https://media.aitoolss.com

# Google Gemini API Free Tier (server-only; never use a NEXT_PUBLIC_ prefix). Direct Gemini is preferred when configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_HUMANIZER_LITE_MODEL=gemini-3.7-flash
GEMINI_HUMANIZER_PRO_MODEL=
GEMINI_HUMANIZER_ULTRA_MODEL=

# Optional paid/credited Vercel AI Gateway fallback (server-only).
# Vercel free monthly credits may require payment method verification and model eligibility.
# Vercel AI Gateway (server-only; never use a NEXT_PUBLIC_ prefix).
# Add a valid key only after approving AI Gateway usage and model pricing.
AI_GATEWAY_API_KEY=
AI_MODEL=

# Optional humanizer model routing. Lite falls back to AI_MODEL.
# Pro and Ultra run only after the owner explicitly configures each model.
AI_HUMANIZER_LITE_MODEL=
AI_HUMANIZER_PRO_MODEL=
AI_HUMANIZER_ULTRA_MODEL=
