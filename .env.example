# Copy to .env.local for local development. Never commit .env.local.
# These are the Supabase project URL and publishable/anon key, intended for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side contact delivery through Resend (keep these values out of NEXT_PUBLIC_* variables).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Vercel AI Gateway: configure a server-only key and model for AI-generated tool outputs.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.5
# Vision-capable AI Gateway model (must support image input).
AI_VISION_MODEL=alibaba/qwen3-vl-235b-a22b-instruct

# remove.bg API key for background removal (limited free API credits).
REMOVE_BG_API_KEY=

# Cloudflare R2 (server-only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aitoolss-gallery
R2_S3_ENDPOINT=
R2_PUBLIC_BASE_URL=https://media.aitoolss.com
