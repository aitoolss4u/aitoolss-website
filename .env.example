# Copy to .env.local for local development. Never commit .env.local.
# These are the Supabase project URL and publishable/anon key, intended for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side contact delivery through Resend (keep these values out of NEXT_PUBLIC_* variables).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Vercel AI Gateway: configure a server-only key and model for AI-generated tool outputs.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.5
