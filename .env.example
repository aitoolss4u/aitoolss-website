# Copy to .env.local for local development. Never commit .env.local.
# These are the Supabase project URL and publishable/anon key, intended for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side contact delivery through Resend (keep these values out of NEXT_PUBLIC_* variables).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
